# ==========================================
# Application
# ==========================================

APP_NAME="Pesan Ajah"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pesanajah.web.id
APP_TIMEZONE=Asia/Jakarta


# ==========================================
# Database
# ==========================================

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_pesanajah
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=change-this-password


# ==========================================
# Session
# ==========================================

SESSION_NAME=pesan_ajah_session
SESSION_SECURE=true


# ==========================================
# Admin Account
# ==========================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# ==========================================
# Anter Ajah — Driver
# ==========================================

DRIVER_USERNAME=nama_driver
DRIVER_PASSWORD=ganti-dengan-password-kuat
DRIVER_NAME=Nama Driver

# Web Push Notification
VAPID_SUBJECT=mailto:admin@pesanajah.web.id
VAPID_PUBLIC_KEY=ISI_PUBLIC_KEY
VAPID_PRIVATE_KEY=ISI_PRIVATE_KEY