Options -Indexes

DirectoryIndex index.php

RewriteEngine On

# =========================================================
# PESAN AJAH — PROTECTION
# =========================================================

# Lindungi direktori internal.
RewriteRule ^(?:app|config|database|scripts|routes)/ - [F,L,NC]

# Lindungi file konfigurasi.
<FilesMatch "^(?:\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>

# Lindungi file database.
<FilesMatch "\.(?:sql|sqlite|db)$">
    Require all denied
</FilesMatch>

# =========================================================
# PESAN AJAH — PUBLIC STORE ROUTING
# =========================================================

# /warung/terasrambutan
# diarahkan ke warung.php?slug=terasrambutan
#
# Aturan ini harus diletakkan sebelum pengecekan
# apakah path merupakan file atau direktori.

RewriteRule ^warung/([A-Za-z0-9_-]+)/?$ warung.php?slug=$1 [QSA,L,NC]

# =========================================================
# PESAN AJAH — EXISTING FILES
# =========================================================

# Biarkan file dan direktori yang memang ada
# ditangani secara langsung oleh server.

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]