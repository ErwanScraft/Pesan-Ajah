Options -Indexes

DirectoryIndex index.php

RewriteEngine On

# =========================================================
# PESAN AJAH — MAINTENANCE MODE
# =========================================================

ErrorDocument 503 /maintenance.php

# Aktif jika file .maintenance tersedia
RewriteCond %{DOCUMENT_ROOT}/.maintenance -f

# IP yang diperbolehkan melewati maintenance
RewriteCond %{REMOTE_ADDR} !^(?:127\.0\.0\.1|::1|GANTI_DENGAN_IP_ANDA|IP_KEDUA)$

# Halaman maintenance tetap dapat diakses
RewriteCond %{REQUEST_URI} !^/maintenance\.php$ [NC]

# Aset tetap dapat diakses
RewriteCond %{REQUEST_URI} !^/assets/ [NC]

# Service worker tetap dapat diakses
RewriteCond %{REQUEST_URI} !^/service-worker\.js$ [NC]

# Aktifkan maintenance
RewriteRule ^ - [R=503,L]

# =========================================================
# PESAN AJAH — PROTECTION
# =========================================================

# Lindungi direktori internal.
RewriteRule ^(?:app|config|database|scripts|routes)/ - [F,L,NC]

# Lindungi file konfigurasi.
<FilesMatch "^(?:\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>

# Lindungi file database.
<FilesMatch "\.(?:sql|sqlite|db)$">
    Require all denied
</FilesMatch>

# =========================================================
# PESAN AJAH — PUBLIC STORE ROUTING
# =========================================================

# /warung/terasrambutan
# diarahkan ke warung.php?slug=terasrambutan
#
# Aturan ini harus diletakkan sebelum pengecekan
# apakah path merupakan file atau direktori.

RewriteRule ^warung/([A-Za-z0-9_-]+)/?$ warung.php?slug=$1 [QSA,L,NC]

# =========================================================
# PESAN AJAH — EXISTING FILES
# =========================================================

# Biarkan file dan direktori yang memang ada
# ditangani secara langsung oleh server.

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# =========================================================
# CSS & JAVASCRIPT CACHE VALIDATION
# =========================================================

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>