Options -Indexes

DirectoryIndex index.html index.php

RewriteEngine On

# Lindungi direktori internal aplikasi.
RewriteRule ^(?:app|config|database|scripts|routes)/ - [F,L,NC]

# Lindungi file konfigurasi.
<FilesMatch "^(?:\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>

# Lindungi file database.
<FilesMatch "\.(?:sql|sqlite|db)$">
    Require all denied
</FilesMatch>

# Jangan memproses ulang file atau direktori yang sudah ada.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# URL selain file dan direktori diarahkan ke router PHP.
RewriteRule ^ index.php [QSA,L]